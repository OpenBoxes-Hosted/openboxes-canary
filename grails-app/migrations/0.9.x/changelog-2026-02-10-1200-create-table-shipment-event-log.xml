<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.9"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.9 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.9.xsd">

    <!-- Shipment has GORM's "hasMany" on EventLog, resulting in this mapping table from shipment to event log -->

    <changeSet author="ewaterman" id="100220261200-0">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="shipment_event_log"/>
            </not>
        </preConditions>
        
        <createTable tableName="shipment_event_log">
            <column name="shipment_id" type="CHAR(38)">
                <constraints nullable="false" />
            </column>
            <column name="event_log_id" type="CHAR(38)">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

    <changeSet author="ewaterman" id="100220261200-1">
        <preConditions onFail="MARK_RAN">
            <!-- A name-only foreignKeyConstraintExists makes Liquibase snapshot every
                 foreign key in the schema when the constraint is absent (the normal
                 case), which with Connector/J means one SHOW CREATE TABLE per table.
                 Measured at 29s-419s per changeset on populated databases. The scoped
                 sqlCheck answers the same question with one indexed query. -->
            <sqlCheck expectedResult="0">
                SELECT COUNT(*)
                FROM information_schema.TABLE_CONSTRAINTS
                WHERE CONSTRAINT_SCHEMA = DATABASE()
                  AND TABLE_NAME = 'shipment_event_log'
                  AND CONSTRAINT_NAME = 'fk_shipment_event_log_shipment'
                  AND CONSTRAINT_TYPE = 'FOREIGN KEY'
            </sqlCheck>
        </preConditions>
        <addForeignKeyConstraint
                baseColumnNames="shipment_id"
                baseTableName="shipment_event_log"
                constraintName="fk_shipment_event_log_shipment"
                deferrable="false"
                initiallyDeferred="false"
                referencedColumnNames="id"
                referencedTableName="shipment"
        />
    </changeSet>

    <changeSet author="ewaterman" id="100220261200-2">
        <preConditions onFail="MARK_RAN">
            <!-- A name-only foreignKeyConstraintExists makes Liquibase snapshot every
                 foreign key in the schema when the constraint is absent (the normal
                 case), which with Connector/J means one SHOW CREATE TABLE per table.
                 Measured at 29s-419s per changeset on populated databases. The scoped
                 sqlCheck answers the same question with one indexed query. -->
            <sqlCheck expectedResult="0">
                SELECT COUNT(*)
                FROM information_schema.TABLE_CONSTRAINTS
                WHERE CONSTRAINT_SCHEMA = DATABASE()
                  AND TABLE_NAME = 'shipment_event_log'
                  AND CONSTRAINT_NAME = 'fk_shipment_event_log_event_log'
                  AND CONSTRAINT_TYPE = 'FOREIGN KEY'
            </sqlCheck>
        </preConditions>
        <addForeignKeyConstraint
                baseColumnNames="event_log_id"
                baseTableName="shipment_event_log"
                constraintName="fk_shipment_event_log_event_log"
                deferrable="false"
                initiallyDeferred="false"
                referencedColumnNames="id"
                referencedTableName="event_log"
        />
    </changeSet>
</databaseChangeLog>
